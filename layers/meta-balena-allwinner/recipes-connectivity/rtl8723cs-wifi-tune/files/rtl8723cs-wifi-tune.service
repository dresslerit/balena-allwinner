[Unit]
Description=RTL8723CS WiFi Tuning for Weak Signals
After=network.target sys-subsystem-net-devices-wlan0.device
BindsTo=sys-subsystem-net-devices-wlan0.device
Before=NetworkManager.service wpa_supplicant.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/rtl8723cs-wifi-tune.sh

# Add recovery on failure
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
