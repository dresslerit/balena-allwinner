[Unit]
Description=RTL8723CS WiFi Interface Tuning (Runtime Settings)
Documentation=man:iw(8) man:iwconfig(8)
After=NetworkManager.service sys-subsystem-net-devices-wlan0.device
Wants=sys-subsystem-net-devices-wlan0.device
# Only run after NetworkManager has brought up the interface
Requisite=sys-subsystem-net-devices-wlan0.device
StartLimitBurst=3
StartLimitIntervalSec=120

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/rtl8723cs-wifi-tune.sh

# No restart needed for oneshot
Restart=no

[Install]
WantedBy=multi-user.target
