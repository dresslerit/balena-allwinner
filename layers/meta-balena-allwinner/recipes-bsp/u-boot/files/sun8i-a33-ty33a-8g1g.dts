/dts-v1/;
#include "sun8i-a33.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "TY33A 8G1G";
	compatible = "sinovoip,bananapi-m2m", "allwinner,sun8i-a33";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;

		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
	};

	chosen { stdout-path = "serial0:115200n8"; };

	/* 5‑V rail for USB‑A port */
	reg_vcc5v0: vcc5v0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/* Wi‑Fi / BT reset (PL7) */
	wifi_pwrseq: wifi_pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>; /* PL7 */
		post-power-on-delay-ms = <200>;   /* Some Realtek modules need up to 200ms before SDIO responds */
	};

	leds {
		compatible = "gpio-leds";

		led_red {
			label  = "ty33a:red:status";
			gpios  = <&pio 1 3 GPIO_ACTIVE_LOW>;  /* PB3 */
			linux,default-trigger = "heartbeat";
		};

		led_green {
			label  = "ty33a:green:wlan";
			gpios  = <&pio 1 6 GPIO_ACTIVE_LOW>;  /* PB6 */
			linux,default-trigger = "phy0tx";
		};
	};
};

/* --------------------------------------------------------------------- */

&pio {
	mmc0_pins: mmc0-pins {
		pins = "PF0","PF1","PF2","PF3","PF4","PF5";
		function = "mmc0";
	};

	mmc1_pins: mmc1-pins {
		pins = "PG0","PG1","PG2","PG3","PG4","PG5";
		function = "mmc1";
	};

	mmc1_cd_pin: mmc1-cd-pin {
		pins = "PB4";
		function = "gpio_in";
	};

	mmc2_pins: mmc2-pins {
		pins = "PC5","PC6","PC8","PC9","PC10","PC11";
		function = "mmc2";
	};
};

/* --------------------------------------------------------------------- */

&cpu0 { cpu-supply = <&reg_dcdc3>; };

/* PMIC on the R‑RSB bus */
&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&nmi_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		eldoin-supply = <&reg_dcdc1>;
		x-powers,drive-vbus-en;
	};
};

#include "axp223.dtsi"

/* -------- fixed regulator names / voltages --------------------------- */

&reg_aldo1  { regulator-name = "vcc-io";   regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; regulator-always-on; };
&reg_aldo2  { regulator-name = "vdd-dll";  regulator-min-microvolt = <2500000>; regulator-max-microvolt = <2500000>; regulator-always-on; };
&reg_aldo3  { regulator-name = "avcc";     regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; regulator-always-on; };
&reg_dcdc1  { regulator-name = "vcc-3v0";  regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; regulator-always-on; };
&reg_dcdc2  { regulator-name = "vdd-sys";  regulator-min-microvolt = < 900000>; regulator-max-microvolt = <1400000>; regulator-always-on; };
&reg_dcdc3  { regulator-name = "vdd-cpu";  regulator-min-microvolt = < 900000>; regulator-max-microvolt = <1400000>; regulator-always-on; };
&reg_dcdc5  { regulator-name = "vcc-dram"; regulator-min-microvolt = <1500000>; regulator-max-microvolt = <1500000>; regulator-always-on; };
&reg_dc5ldo { regulator-name = "vdd-cpus"; regulator-min-microvolt = < 900000>; regulator-max-microvolt = <1400000>; regulator-always-on; };
&reg_drivevbus { regulator-name = "usb0-vbus"; regulator-always-on; status = "okay"; };
&reg_rtc_ldo { regulator-name = "vcc-rtc"; };

/* --------------------------------------------------------------------- */
/* Storage                                                               */

&mmc0 { /* eMMC on PF0-PF5 */
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	vmmc-supply = <&reg_dcdc1>;
	bus-width = <8>;
	non-removable;
	status = "okay";
};

&mmc1 { /* µSD on PG0-PG5 */
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins &mmc1_cd_pin>;
	vmmc-supply = <&reg_dcdc1>;
	bus-width = <4>;
	cd-gpios = <&pio 1 4 GPIO_ACTIVE_LOW>; /* PB4 */
	status = "okay";
};

&mmc2 { /* Wi‑Fi (RTL8723CS) on PC pins */
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_pins>;
	vmmc-supply = <&reg_aldo1>;
	vqmmc-supply = <&reg_aldo1>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";
};

/* --------------------------------------------------------------------- */
/* UARTs                                                                 */

&uart0 { status = "okay"; };  /* debug console */
&uart1 { status = "disabled"; };
&uart2 { status = "okay"; };

/* --------------------------------------------------------------------- */
/* USB                                                                   */

&usb_otg { dr_mode = "otg"; status = "okay"; };

&usbphy {
	usb0_id_det-gpios      = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 */
	usb0_vbus_power-supply = <&usb_power_supply>; /* label from axp22x.dtsi */
	usb0_vbus-supply       = <&reg_drivevbus>;
	usb1_vbus-supply       = <&reg_vcc5v0>;
	status = "okay";
};
