/dts-v1/;
#include "sun8i-a33.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>

/ {
    model = "TY33A 8G1G (Allwinner A33) NDB";
    compatible = "allwinner,sun8i-a33-tablet", "allwinner,sun8i-a33";

    aliases {
        serial0 = &uart0;
        mmc0    = &mmc0;
        mmc1    = &mmc1;
        mmc2    = &mmc2;
        usb-power-supply = &vcc5v0;
    };

    chosen { stdout-path = "serial0:115200n8"; };

    /* --- always-on 5 V rail ------------------------------------------------ */
    vcc5v0: vcc5v0 {
        compatible = "regulator-fixed";
        regulator-name = "vcc5v0";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        regulator-always-on;
    };

    /* --- Wi-Fi reset line --------------------------------------------------- */
    wifi_pwrseq: wifi_pwrseq {
        compatible             = "mmc-pwrseq-simple";
        reset-gpios            = <&r_pio 0 7 GPIO_ACTIVE_LOW>;  /* PL7 */
        post-power-on-delay-ms = <200>;
    };



    /* --- LVDS panel --------------------------------------------------------- */
    panel_lvds: panel-lvds@0 {
        compatible    = "simple-panel", "panel-lvds";
        power-supply  = <&reg_dcdc1>;
        backlight     = <&backlight>;
        data-mapping  = "jeida-18";
        width-mm      = <331>;
        height-mm     = <207>;

        panel-timing {
            clock-frequency = <72200000>;
            hactive         = <1280>;
            vactive         = <800>;
            hsync-len       = <32>;
            hfront-porch    = <24>;
            hback-porch     = <64>;
            vsync-len       = <6>;
            vfront-porch    = <3>;
            vback-porch     = <7>;
            de-active       = <1>;
            pixelclk-active = <0>;
        };

        port {
            panel_in: endpoint {
                remote-endpoint = <&tcon0_out_lvds>;
            };
        };
    };


    /* --- LED back-light ----------------------------------------------------- */
    backlight: backlight {
            compatible          = "pwm-backlight";
            pwms                = <&pwm 0 20000 PWM_POLARITY_INVERTED>; /* PH0 → PWM0 */
            enable-gpios        = <&pio 7 6 GPIO_ACTIVE_HIGH>;          /* *** PH6 *** */
            power-supply        = <&dc1sw>;
            brightness-levels   = <0   25   50   75  100  130  160  200  255>;
            default-brightness-level = <8>;
            default-state       = "on";
            pinctrl-names       = "default";
            pinctrl-0           = <&bl_en_pin>;
    };
};

/* ---------------- Per-IP enabling ---------------------------------------- */
&uart0  { status = "okay"; };
&usb_otg { dr_mode = "peripheral"; status = "okay"; };
&usbphy  { status = "okay"; usb1_vbus-supply = <&vcc5v0>; };
&drc0 { status = "okay"; };
&fe0  { status = "okay"; };
&pwm {
    pinctrl-names = "default";
    pinctrl-0 = <&pwm0_pins>;
    status = "okay";
};
&sound { status = "okay"; };
&ths   { status = "okay"; };

/* ---------------- MMC ----------------------------------------------------- */
&mmc0 {
    pinctrl-names  = "default";
    pinctrl-0      = <&mmc0_pins>;
    vmmc-supply    = <&reg_dldo1>;
    vqmmc-supply   = <&reg_dldo1>;
    bus-width      = <4>;
    cd-gpios       = <&pio 1 4 GPIO_ACTIVE_LOW>;  /* PB4 */
    cd-inverted;
    status = "okay";
};

&mmc1 {
    pinctrl-names  = "default";
    pinctrl-0      = <&mmc1_pg_pins>;
    vmmc-supply    = <&reg_dldo1>;
    vqmmc-supply   = <&reg_aldo1>;
    mmc-pwrseq     = <&wifi_pwrseq>;
    bus-width      = <4>;
    non-removable;
    cap-sdio-irq;
    keep-power-in-suspend;
    status = "okay";
};

&mmc2 {
    pinctrl-names  = "default";
    pinctrl-0      = <&mmc2_8bit_pins>;
    vmmc-supply    = <&reg_dldo1>;
    vqmmc-supply   = <&reg_dldo1>;
    bus-width      = <8>;
    non-removable;
    cap-mmc-hw-reset;
    status = "okay";
};

/* ---------------- PMIC / regulators -------------------------------------- */
&r_rsb {
    status = "okay";

    axp22x: pmic@3a3 {
        compatible = "x-powers,axp223";
        reg        = <0x3a3>;
        interrupt-parent = <&nmi_intc>;
        interrupts = <0 IRQ_TYPE_LEVEL_LOW>;

        vin1-supply = <&vcc5v0>;
        vin2-supply = <&vcc5v0>;
        vin3-supply = <&vcc5v0>;
        vin4-supply = <&vcc5v0>;
        vin5-supply = <&vcc5v0>;
        aldoin-supply = <&reg_dcdc1>;
        dldoin-supply = <&reg_dcdc1>;
        eldoin-supply = <&reg_dcdc1>;

        regulators {
            dcdc1{ regulator-always-on; regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; };
            dcdc2  { regulator-always-on; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; };
            dcdc3  { regulator-always-on; regulator-min-microvolt = <1320000>; regulator-max-microvolt = <1320000>; };
            dcdc5  { regulator-always-on; regulator-min-microvolt = <1500000>; regulator-max-microvolt = <1500000>; };

            dc1sw: dc1sw { regulator-name = "bl_3v_boost_in"; regulator-boot-on; regulator-always-on;};

            dc5ldo { regulator-always-on; };

            aldo1  { regulator-always-on; regulator-bootstrap; regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; };
            aldo2  { regulator-always-on; regulator-min-microvolt = <2500000>; regulator-max-microvolt = <2500000>; };
            aldo3  { regulator-always-on; regulator-bootstrap; regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; };

            dldo1  { regulator-always-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; };
            dldo2  { regulator-always-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; };

            eldo1  { regulator-always-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; };
        };
    };
};

#include "axp223.dtsi"

/* ---------------- Pin-mux ------------------------------------------------- */
&pio {
    status = "okay";

    pwm0_pins: pwm0_pins {
        pins     = "PH0";
        function = "pwm0";
    };

    bl_en_pin: bl_en_pin {
            pins     = "PH6";
            function = "gpio_out";
    };
};

/* ---------------- TCON / display engine ---------------------------------- */

/* 1. Enable the main display engine and backend */
&de {
	status = "okay";
};

&be0 {
	status = "okay";
};

/* 2. Define the data path link from the Backend's output */
&be0_out {
	remote-endpoint = <&tcon0_in_be0>;
};

/* 3. Define the TCON with its supplies and all ports */
&tcon0 {
	status          = "okay";
	vdd-lcd-supply  = <&reg_dcdc1>;
	vcc-lvds-supply = <&reg_dldo1>;
    
    lvds0: lvds-encoder {
            compatible = "allwinner,sun8i-a33-lvds-encoder";
            status = "okay";

            ports {
                    #address-cells = <1>;
                    #size-cells = <0>;

                    /* input from the TCON */
                    port@0 {
                            reg = <0>;
                            lvds0_in: endpoint {
                                    remote-endpoint = <&tcon0_out_lvds>;
                            };
                    };

                    /* output to the panel */
                    port@1 {
                            reg = <1>;
                            lvds0_out: endpoint {
                                    remote-endpoint = <&panel_in>;
                            };
                    };
            };
    };

	/* Input port from the Display Backend */
	port@0 {
		reg = <0>;
		tcon0_in_be0: endpoint {
			remote-endpoint = <&be0_out>;
		};
	};

	/* Output port to the LVDS bridge */
	port@1 {
		reg = <1>;
		tcon0_out_lvds: endpoint {
			remote-endpoint = <&lvds0_in>;
			allwinner,tcon-channel = <0>;
		};
	};
};