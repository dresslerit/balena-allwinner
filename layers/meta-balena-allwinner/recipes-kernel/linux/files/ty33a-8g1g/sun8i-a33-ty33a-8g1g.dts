/dts-v1/;
#include "sun8i-a33.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>

/ {
	model = "TY33A 8G1G (Allwinner A33) NDB - Corrected";
	compatible = "allwinner,sun8i-a33-tablet", "allwinner,sun8i-a33";

	aliases {
		serial0 = &uart0;
		mmc0    = &mmc0;
		mmc1    = &mmc1;
		mmc2    = &mmc2;
		usb-power-supply = &reg_vcc5v0;
		display0 = &display;
		/* Allow U-Boot to set MAC address for RTL8723CS (no eeprom) */
		ethernet0 = &rtl8723cs;
	};

	chosen { 
		stdout-path = "serial0:115200n8"; 
	};	/* ---------- simplefb handoff placeholders (U-Boot will 'okay' one) --- */
	display: framebuffer@0 {
		compatible = "allwinner,simple-framebuffer", "simple-framebuffer";
		allwinner,pipeline = "de_be0-lcd0";
		clocks = <&ccu CLK_BUS_LCD>, <&ccu CLK_BUS_DE_BE>, <&ccu CLK_LCD_CH0>,
			 <&ccu CLK_DE_BE>, <&ccu CLK_DRAM_DE_BE>;
		status = "disabled";
	};

	/* Keep a mixer path too; harmless if your SoC/DT doesn’t expose it */
	framebuffer@1 {
		compatible = "allwinner,simple-framebuffer", "simple-framebuffer";
		allwinner,pipeline = "mixer0-lcd0";
		status = "disabled";
	};

	wifi_pwrseq: wifi_pwrseq {
		compatible             = "mmc-pwrseq-simple";
		reset-gpios            = <&r_pio 0 7 GPIO_ACTIVE_LOW>;  /* PL7 */
		post-power-on-delay-ms = <200>;
	};

	/* --- LVDS panel (Samsung LTN154AT12) ----------------------------------- */
	panel_lvds: panel-lvds@0 {
		compatible    = "panel-lvds";
		power-supply  = <&reg_dc1sw>;
		backlight     = <&backlight>;
		data-mapping  = "jeida-18";
		bpc           = <6>;

		width-mm      = <331>;
		height-mm     = <207>;

		panel-timing {
			clock-frequency = <68544000>;
			hactive = <1280>; vactive = <800>;
			hfront-porch = <24>;  hback-porch = <64>;  hsync-len = <32>;
			vfront-porch = <3>;   vback-porch = <7>;   vsync-len = <6>;
			de-active      = <1>;
			hsync-active   = <0>;
			vsync-active   = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_lvds_in: endpoint {
				remote-endpoint = <&tcon0_out_lvds>;
			};
		};
	};

	/* --- LED back-light ----------------------------------------------------- */
	backlight: backlight {
		compatible          = "pwm-backlight";
		pwms                = <&pwm 0 20000 PWM_POLARITY_INVERTED>; /* PH0 → PWM0 */
		enable-gpios        = <&pio 7 6 GPIO_ACTIVE_HIGH>;          /* PH6 */
		power-supply        = <&reg_dc1sw>;
		brightness-levels   = <0 25 50 75 100 130 160 200 255>;
		default-brightness-level = <6>;
		default-state       = "on";
		pinctrl-names       = "default";
		pinctrl-0           = <&bl_en_pin>;
	};
};


/* ---------------- CPUs ---------------------------------------- */

&cpu0 {
	clock-frequency = <1200000000>;
};

&cpu1 {
	clock-frequency = <1200000000>;
};

&cpu2 {
	clock-frequency = <1200000000>;
};

&cpu3 {
	clock-frequency = <1200000000>;
};


/* ---------------- Per-IP enabling ---------------------------------------- */
&uart0   { status = "okay"; };

&ehci0 {
    status = "okay";
};

&ohci0 {
    status = "okay";
};

&usb_otg {
    dr_mode = "otg";
    status = "okay";
};

&usbphy {
    usb0_vbus-supply = <&reg_drivevbus>;
    usb1_vbus-supply = <&reg_vcc5v0>;  /* from sunxi-common-regulators.dtsi */
    status = "okay";
};

&drc0    { status = "okay"; };
&fe0     { status = "okay"; };

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pins>;
	status = "okay";
};

&sound { status = "okay"; };
&ths   { status = "okay"; };

/* ---------------- MMC ----------------------------------------------------- */
&mmc0 {
	pinctrl-names  = "default";
	pinctrl-0      = <&mmc0_pins>;
	vmmc-supply    = <&reg_dldo1>;
	vqmmc-supply   = <&reg_dldo1>;
	bus-width      = <4>;
	cd-gpios       = <&pio 1 4 GPIO_ACTIVE_LOW>;  /* PB4 */
	status = "okay";
};

&mmc1 {
	pinctrl-names  = "default";
	pinctrl-0      = <&mmc1_pg_pins>;
	vmmc-supply    = <&reg_dldo1>;
	vqmmc-supply   = <&reg_aldo1>;
	mmc-pwrseq     = <&wifi_pwrseq>;
	bus-width      = <4>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;
	status = "okay";

	rtl8723cs: wifi@1 {
		reg = <1>;
		compatible = "realtek,rtl8723cs-wlan";
	};
};

&mmc2 {
	pinctrl-names  = "default";
	pinctrl-0      = <&mmc2_8bit_pins>;
	vmmc-supply    = <&reg_dldo1>;
	vqmmc-supply   = <&reg_dldo1>;
	bus-width      = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status = "okay";
};

/* ---------------- PMIC / regulators -------------------------------------- */
&r_rsb {
	status = "okay";

	axp22x: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&r_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		eldoin-supply = <&reg_dcdc1>;
		x-powers,drive-vbus-en;
		vin1-supply = <&reg_vcc5v0>;
		vin2-supply = <&reg_vcc5v0>;
		vin3-supply = <&reg_vcc5v0>;
	};
};

#include "axp223.dtsi"

&reg_aldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-io";
};

&reg_aldo2 {
	regulator-always-on;
	regulator-min-microvolt = <2350000>;
	regulator-max-microvolt = <2650000>;
	regulator-name = "vdd-dll";
};

&reg_aldo3 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-avcc";
};

&reg_dc1sw {
	regulator-name = "vcc-lcd";
	regulator-always-on;
};

&reg_dc5ldo {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpus";
};

&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-3v3";
};

&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-sys";
};

&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpu";
};

&reg_dcdc5 {
	regulator-always-on;
	regulator-min-microvolt = <1500000>;
	regulator-max-microvolt = <1500000>;
	regulator-name = "vcc-dram";
};

&reg_dldo1 {
	regulator-name = "vcc-mmc";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-boot-on;
	regulator-always-on;
};

&reg_drivevbus {
	regulator-name = "usb0-vbus";
	status = "okay";
};

&reg_rtc_ldo {
	regulator-name = "vcc-rtc";
};

/* ---------------- Pin-mux ------------------------------------------------- */
&pio {
	status = "okay";
    vcc-pc-supply = <&reg_dcdc1>;   /* vcc-3v3 */
    vcc-pd-supply = <&reg_dcdc1>;
    vcc-pf-supply = <&reg_dcdc1>;
    vcc-pg-supply = <&reg_dcdc1>;

	vcc-pb-supply = <&reg_dldo1>;
	vcc-ph-supply = <&reg_dldo1>;

	/* Replace your old lvds0_pins node with this corrected version */
	lvds0_pins: lvds0_pins {
		pins = "PD18", "PD19", "PD20", "PD21", "PD22",
			"PD23", "PD24", "PD25", "PD26", "PD27";
		function = "lvds0";
	};

	pwm0_pins: pwm0_pins {
		pins     = "PH0";
		function = "pwm0";
	};

	bl_en_pin: bl_en_pin {
		pins     = "PH6";
		function = "gpio_out";
	};
};

/* ---------------- TCON / display engine ---------------------------------- */
&de    { status = "okay"; };
&be0   { status = "okay"; };
&codec { status = "okay"; };

&mali {
	operating-points-v2 = <&mali_opp_table>;
	status = "okay";
};

&be0_out {
	remote-endpoint = <&tcon0_in_be0>;
};

&tcon0 {
	status          = "okay";
	pinctrl-names   = "default";
	pinctrl-0       = <&lvds0_pins>;
	vdd-lcd-supply  = <&reg_dcdc1>;
	vcc-lvds-supply = <&reg_dldo1>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			tcon0_in_be0: endpoint { remote-endpoint = <&be0_out>; };
		};

		port@1 {
			reg = <1>;
			tcon0_out_lvds: endpoint {
				allwinner,tcon-channel = <0>;
				remote-endpoint = <&panel_lvds_in>;
			};
		};
	};
};