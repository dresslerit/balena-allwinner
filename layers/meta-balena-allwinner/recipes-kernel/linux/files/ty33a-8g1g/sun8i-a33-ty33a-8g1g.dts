/dts-v1/;
#include "sun8i-a33.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
/ {
	model = "TY33A 8G1G (Allwinner A33) NDB";
    compatible = "allwinner,sun8i-a33-tablet", "allwinner,sun8i-a33";

	aliases {
		serial0 = &uart0;
		mmc0    = &mmc0;
		mmc1    = &mmc1;
		mmc2    = &mmc2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	r_ccu: clock-controller@1f01400 {
		compatible   = "allwinner,sun8i-a23-r-ccu";
		reg          = <0x01f01400 0x100>;
		clocks       = <&osc24M>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	vcc5v0: vcc5v0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0"; /* ADD THIS */

		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	wifi_pwrseq: wifi_pwrseq {
		compatible              = "mmc-pwrseq-simple";
		reset-gpios             = <&r_pio 0 7 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms  = <200>;
	};

	panel_power: panel-power {
		compatible = "regulator-fixed";
		regulator-name = "panel_power";

		enable-gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>;     /* PH6 */
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		startup-delay-us = <10000>; /* 10ms */
	};
	

	panel_lvds: panel-lvds@0 {
		compatible = "panel-lvds";
        power-supply    = <&panel_power>;
        backlight       = <&backlight>;
		data-mapping = "jeida-18";
		width-mm     = <331>;
		height-mm    = <207>;

		panel-timing {
			clock-frequency = <72200000>;
			hactive         = <1280>;
			vactive         = <800>;
			hsync-len       = <32>;
			hfront-porch    = <24>;
			hback-porch     = <64>;
			vsync-len       = <6>;
			vfront-porch    = <3>;
			vback-porch     = <7>;
			de-active       = <1>;
			pixelclk-active = <0>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&tcon0_lvds_out>;
				allwinner,tcon-channel = <0>;
			};
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 20000 PWM_POLARITY_INVERTED>;  /* 50 kHz, inverted */
		enable-gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>;   /* PH7 = BL_EN */
		power-supply = <&dc1sw>;                     /* use DC1SW fed rail */
		brightness-levels = <0 4 8 16 32 64 128 192 255>;
		default-brightness-level = <8>;
	};

};

&uart0 { status = "okay"; };

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0     = <&mmc0_pins>;
    vmmc-supply   = <&dldo1>;
    vqmmc-supply  = <&dldo1>;
	bus-width     = <4>;
	cd-gpios      = <&pio 1 4 GPIO_ACTIVE_LOW>;
	cd-inverted;
	status        = "okay";
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0     = <&mmc1_pg_pins>;
	vmmc-supply   = <&dldo1>;
	vqmmc-supply  = <&aldo1>;
	mmc-pwrseq    = <&wifi_pwrseq>;
	bus-width     = <4>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;
	status        = "okay";
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0     = <&mmc2_8bit_pins>;
    vmmc-supply   = <&dldo1>;
    vqmmc-supply  = <&dldo1>;
	bus-width     = <8>;
	non-removable;
	cap-mmc-hw-reset;
	status        = "okay";
};

&usb_otg { dr_mode = "peripheral"; status = "okay"; };
&usbphy  { status  = "okay"; usb1_vbus-supply = <&vcc5v0>; };

&r_pio { 
	status = "okay";
};


&pio {
	status = "okay";
	
	vcc-pb-supply = <&dldo2>;
	vcc-pc-supply = <&dldo2>;
	vcc-pe-supply = <&dldo2>;
	vcc-pg-supply = <&dldo2>;

	vcc-pd-supply = <&dcdc1>;
	vcc-pf-supply = <&dcdc1>;

	pwm0_pins: pwm0_pins {
		pins            = "PH0";
		function        = "pwm0";
	};

	lcd_pwr_pins: lcd_pwr_pins {
		pins = "PH6";
		function = "gpio_out";
	};
};

&r_rsb {
	status = "okay";
	axp223: pmic@3a3 {
		compatible = "x-powers,axp223";
		reg = <0x3a3>;
		interrupt-parent = <&nmi_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>; 
		};
	};
};
#include "axp22x.dtsi"

&reg_aldo1 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "vcc-io";
};

&reg_aldo2 {
	regulator-always-on;
	regulator-min-microvolt = <2350000>;
	regulator-max-microvolt = <2650000>;
	regulator-name = "vdd-dll";
};

&reg_aldo3 {
	regulator-always-on;
	regulator-min-microvolt = <2700000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-pll-avcc";
};

&reg_dc1sw {
	regulator-name = "vcc-lcd";
};

&reg_dc5ldo {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpus";
};

&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "vcc-3v0";
};

&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-sys";
};

&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpu";
};

&reg_dcdc5 {
	regulator-always-on;
	regulator-min-microvolt = <1500000>;
	regulator-max-microvolt = <1500000>;
	regulator-name = "vcc-dram";
};

&reg_dldo1 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
};

&reg_drivevbus {
	regulator-name = "usb0-vbus";
	status = "okay";
};

&reg_rtc_ldo {
	regulator-name = "vcc-rtc";
};

&r_uart {
	pinctrl-names = "default";
	pinctrl-0 = <&r_uart_pins_a>;
	status = "okay";
};

&simplefb_lcd {
	vcc-lcd-supply = <&reg_dc1sw>;
};

&usb_otg {
	dr_mode = "otg";
	status = "okay";
};

&usb_power_supply {
	status = "okay";
};

&usbphy {
	pinctrl-names = "default";
	pinctrl-0 = <&usb0_id_detect_pin>;
	usb0_id_det-gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 */
	usb0_vbus_power-supply = <&usb_power_supply>;
	usb0_vbus-supply = <&reg_drivevbus>;
	status = "okay";
};

&be0  { status = "okay"; };
&drc0 { status = "okay"; };
&fe0  { status = "okay"; };
&pwm  { status = "okay"; };

&tcon0 {
	status          = "okay";
	vdd-lcd-supply  = <&dcdc1>;

	port@1 {
		reg = <1>;
		tcon0_lvds_out: endpoint {
			reg = <0>;
			remote-endpoint        = <&panel_in>;
			allwinner,tcon-channel = <0>;
		};
	};
};

&sound { status = "okay"; };
&ths   { status = "okay"; };
