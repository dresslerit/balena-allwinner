#!/bin/sh
set -o errexit

# shellcheck disable=SC1091
. /usr/sbin/balena-config-vars

# machine specific data
UBOOT_FILE="/mnt/boot/u-boot-sunxi-with-spl.bin"
EMMC_DEV="/dev/mmcblk2"
BOOT0_DEV="${EMMC_DEV}boot0"

# 0) sanity: file present
[ -s "$UBOOT_FILE" ] || { echo "Missing $UBOOT_FILE"; exit 1; }

# 1) make boot0 writable
echo 0 > /sys/block/mmcblk2boot0/force_ro || true

# 2) configure eMMC to boot from boot0 (persistent)
if command -v mmc >/dev/null 2>&1; then
  # BOOT_ACK=1, boot partition = 1 (boot0)
  mmc bootpart enable 1 1 "$EMMC_DEV" || true
  # conservative boot bus config (optional but recommended)
  mmc bootbus set single_hs x1 x4 "$EMMC_DEV" || true
fi

# 3) write the combined SPL+U-Boot to boot0 @ LBA 0
dd if="$UBOOT_FILE" of="$BOOT0_DEV" bs=4096 conv=fsync,notrunc

# 5) quick verification
dd if="$BOOT0_DEV" bs=64 count=1 2>/dev/null | hexdump -C | head -n1
dd if="$EMMC_DEV" bs=512 skip=80 count=1 2>/dev/null | hexdump -C | head -n1 || true

# 6) re-protect boot0 (optional)
echo 1 > /sys/block/mmcblk2boot0/force_ro || true

echo "Flashed $UBOOT_FILE to eMMC boot0 and (optionally) U-Boot proper to user@LBA80."